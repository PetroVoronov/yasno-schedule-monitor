# Telegram bot token used to post schedule updates (bot mode, the default)
TELEGRAM_BOT_AUTH_TOKEN=
# Optional: a separate bot for the management interface. Defaults to TELEGRAM_BOT_AUTH_TOKEN.
TELEGRAM_MANAGEMENT_BOT_TOKEN=
# Comma separated Telegram user ids allowed to manage the monitor. Empty disables the management interface.
TELEGRAM_ADMIN_IDS=

# Only for --as-user mode (MTProto user session)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Per group settings. Group ids are the ones Yasno uses (e.g. 12.1), written as <group>_<subgroup>.
# A group is active once it has a calendar id. These values only seed an empty config.json;
# afterwards the stored value wins and can be changed through the management bot.
CALENDAR_ID_GROUP_1_1=
TELEGRAM_CHAT_ID_GROUP_1_1=
TELEGRAM_TOPIC_ID_GROUP_1_1=
SVITLOBOT_CHANNEL_ID_GROUP_1_1=
